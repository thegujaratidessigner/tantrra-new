# Copy to .env.local for local development. Never commit real values.
# In Vercel: Project → Settings → Environment Variables.

# Razorpay — Dashboard → Account & Settings → API Keys (use Test Mode keys first).
# The Key ID is sent to the browser by the server; the secret never leaves the server.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_test_key_secret

# Razorpay — Dashboard → Account & Settings → Webhooks → secret you choose when creating the webhook.
# Webhook URL: https://<your-domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# Safety switch: live keys (rzp_live_...) are refused unless this is exactly "true".
RAZORPAY_ALLOW_LIVE=false

# PostgreSQL connection string (server-only). For Supabase use the
# Transaction pooler URI (port 6543) from Project Settings → Database.
DATABASE_URL=postgresql://user:password@host:6543/postgres
