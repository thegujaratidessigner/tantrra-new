# Copy to .env.local for local development. Never commit real values.
# Vercel: Project → Settings → Environment Variables. Keep Preview (test) and
# Production (live) values separate; Production stays empty until go-live is approved.

# ── Supabase database (server-only) ──────────────────────────────────────────
# Supabase → Connect → "Transaction pooler" (port 6543) — recommended for Vercel.
# A Session pooler URI (port 5432) also works but is limited to 1 connection per
# serverless instance. The direct db.<ref>.supabase.co host is IPv6-only and
# cannot be reached from Vercel. URL-encode special characters in the password.
DATABASE_URL=

# ── Supabase API (needed from Milestone 2: admin login + media storage) ─────
# Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or, on older projects, the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy service_role key. SERVER-ONLY — never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ── Razorpay (Test Mode keys only until live is approved) ────────────────────
# Razorpay Dashboard (Test Mode) → Account & Settings → API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard (Test Mode) → Webhooks → the secret you set on the webhook.
RAZORPAY_WEBHOOK_SECRET=
# Live keys (rzp_live_...) are refused unless this is exactly "true". Leave false.
RAZORPAY_ALLOW_LIVE=false
